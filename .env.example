# Copy to .env.local and fill in. Never commit real keys.

# Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Upstox developer console: analytics token (read-only market data)
UPSTOX_ANALYTICS_TOKEN=

# Google Cloud OAuth client (Web), Gmail API enabled, consent screen in Testing
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Any long random string; encrypts the Google session cookie
AUTH_SECRET=
